pipeline{
    agent any
    stages{
        stage("Execute Dockerfile"){
            steps{
                sh 'docker build -t springboot:v2.1 .'
            }
        }
        stage("Creting container"){
            steps{
                sh 'docker run -d -p 9090:9090 springboot:v2.1'
            }
        }
    }
    post{
        success{
            emailext(
                to :'rakesh.cs779@gmail.com, siddardha070@gmail.com ',
                subject : 'About Springboot Project ',
                body : 'http://192.168.255.254:9090'
            )
        }
    }
}
